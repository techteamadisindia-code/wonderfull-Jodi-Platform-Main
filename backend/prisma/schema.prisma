model Country {
  id         String   @id @map("_id") @db.VarChar(36)
  name       String   @unique @db.VarChar(150)
  code       String   @unique @db.VarChar(10)
  isoCode    String   @map("isoCode") @db.VarChar(10)
  phoneCode  String?  @map("phoneCode") @db.VarChar(20)
  isActive   Boolean  @default(true) @map("isActive")
  sortOrder  Int      @default(999) @map("sortOrder")
  sourceType String   @default("GOVERNMENT") @map("sourceType") @db.VarChar(50)
  source     String   @default("ISO-3166 / Census India") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @updatedAt @map("updatedAt")

  states    State[]
  districts District[]

  @@map("countries")
}

model State {
  id         String   @id @map("_id") @db.VarChar(36)
  countryId  String   @map("countryId") @db.VarChar(36)
  name       String   @db.VarChar(150)
  code       String   @db.VarChar(20)
  type       String   @default("State") @db.VarChar(50)
  lgdCode    String?  @map("lgdCode") @db.VarChar(50)
  censusCode String?  @map("censusCode") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("isActive")
  sortOrder  Int      @default(999) @map("sortOrder")
  sourceType String   @default("GOVERNMENT") @map("sourceType") @db.VarChar(50)
  source     String   @default("LGD / Census India") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @updatedAt @map("updatedAt")

  country      Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  districts    District[]
  subDistricts SubDistrict[]
  cities       City[]
  villages     Village[]

  @@unique([countryId, name])
  @@index([code])
  @@index([lgdCode])
  @@map("states")
}

model District {
  id           String   @id @map("_id") @db.VarChar(36)
  stateId      String   @map("stateId") @db.VarChar(36)
  countryId    String   @map("countryId") @db.VarChar(36)
  name         String   @db.VarChar(150)
  code         String?  @db.VarChar(20)
  lgdCode      String?  @map("lgdCode") @db.VarChar(50)
  // censusCode   String?  @map("census_code") @db.VarChar(50)
  headquarters String?  @db.VarChar(150)
  isActive     Boolean  @default(true) @map("isActive")
  sourceType   String   @default("GOVERNMENT") @map("sourceType") @db.VarChar(50)
  source       String   @default("Local Government Directory (LGD)") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @updatedAt @map("updatedAt")

  state        State         @relation(fields: [stateId], references: [id], onDelete: Cascade)
  country      Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  subDistricts SubDistrict[]
  cities       City[]
  villages     Village[]

  @@unique([stateId, name])
  @@index([lgdCode])
  @@map("districts")
}

model SubDistrict {
  id         String   @id @map("_id") @db.VarChar(36)
  districtId String   @map("districtId") @db.VarChar(36)
  stateId    String   @map("stateId") @db.VarChar(36)
  name       String   @db.VarChar(150)
  // code       String?  @db.VarChar(20)
  type       String   @default("Taluka") @db.VarChar(50)
  lgdCode    String?  @map("lgdCode") @db.VarChar(50)
  // censusCode String?  @map("census_code") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("isActive")
  sourceType String   @default("GOVERNMENT") @map("sourceType") @db.VarChar(50)
  source     String   @default("Local Government Directory (LGD)") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("createdAt")
  updatedAt  DateTime @updatedAt @map("updatedAt")

  district District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  state    State     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  cities   City[]
  villages Village[]

  @@unique([districtId, name])
  @@index([lgdCode])
  @@map("subdistricts")
}

model City {
  id            String   @id @map("id") @db.VarChar(36)
  districtId    String   @map("district_id") @db.VarChar(36)
  stateId       String   @map("state_id") @db.VarChar(36)
  subDistrictId String?  @map("sub_district_id") @db.VarChar(36)
  name          String   @db.VarChar(150)
  // code          String?  @db.VarChar(20)
  type          String   @default("City") @db.VarChar(50)
  pincode       String?  @db.VarChar(20)
  // lgdCode       String?  @map("lgd_code") @db.VarChar(50)
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(999) @map("sort_order")
  sourceType    String   @default("GOVERNMENT") @map("source_type") @db.VarChar(50)
  source        String   @default("Local Government Directory (LGD) / ULB Master") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  district    District     @relation(fields: [districtId], references: [id], onDelete: Cascade)
  state       State        @relation(fields: [stateId], references: [id], onDelete: Cascade)
  subDistrict SubDistrict? @relation(fields: [subDistrictId], references: [id], onDelete: SetNull)

  @@index([districtId, name])
  @@index([name])
  @@index([pincode])
  @@map("cities")
}

model Village {
  id            String   @id @map("_id") @db.VarChar(36)
  subDistrictId String   @map("subDistrictId") @db.VarChar(36)
  districtId    String   @map("districtId") @db.VarChar(36)
  stateId       String   @map("stateId") @db.VarChar(36)
  name          String   @db.VarChar(150)
  // code          String?  @db.VarChar(20)
  // villageCode   String?  @map("village_code") @db.VarChar(50)
  lgdCode       String?  @map("lgdCode") @db.VarChar(50)
  pincode       String?  @db.VarChar(20)
  isActive      Boolean  @default(true) @map("isActive")
  sourceType    String   @default("GOVERNMENT") @map("sourceType") @db.VarChar(50)
  source        String   @default("Local Government Directory (LGD)") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")

  subDistrict SubDistrict @relation(fields: [subDistrictId], references: [id], onDelete: Cascade)
  district    District    @relation(fields: [districtId], references: [id], onDelete: Cascade)
  state       State       @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([subDistrictId, name])
  @@index([name])
  @@map("villages")
}

