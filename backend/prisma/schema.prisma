  coupon       Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([referrerUserId, status])
  @@index([referrerCandidateId, status])
  @@map("referrals")
}

model ReferralRewardConfig {
  id                   String   @id @map("_id") @db.VarChar(36)
  requiredReferrals    Int      @default(5) @map("required_referrals")
  qualificationEvent   String   @default("REGISTERED") @map("qualification_event") @db.VarChar(50)
