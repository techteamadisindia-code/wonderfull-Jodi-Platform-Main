# ==============================================================================
# Wonderful Jodi Doctor Matrimony - Backend Environment Configuration
# ==============================================================================
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=https://wonderfuljodi.com

# ──────────────────────────────────────────────────────────────────────────────
# HOSTINGER MYSQL / MARIADB DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=prefer&connection_limit=10
#
# Examples:
#   Hostinger Cloud / Web Hosting:
#     DATABASE_URL="mysql://u625755214_wonderfuljodi:<YOUR_PASSWORD>@srv1646.hstgr.io:3306/u625755214_wonderfuljodi"
#
#   Hostinger VPS (Local MySQL / MariaDB on Ubuntu):
#     DATABASE_URL="mysql://wonderful_user:<YOUR_PASSWORD>@127.0.0.1:3306/wonderfuljodi?connection_limit=10"
#
#   Local Development:
#     DATABASE_URL="mysql://root:password@127.0.0.1:3306/wonderfuljodi"
DATABASE_URL="mysql://u625755214_wonderfuljodi:<YOUR_PASSWORD>@srv1646.hstgr.io:3306/u625755214_wonderfuljodi"


# ──────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ──────────────────────────────────────────────────────────────────────────────
# Mandatory JWT signing secret for member access tokens (min 32 chars, high entropy)
JWT_SECRET=replace_with_min_32_char_member_access_token_secret
# Mandatory dedicated JWT signing secret for administrator access tokens (min 32 chars, strictly distinct from JWT_SECRET)
JWT_ADMIN_SECRET=replace_with_min_32_char_admin_access_token_secret
JWT_EXPIRES_IN=7d
# Note: Refresh tokens are opaque 40-byte random strings hashed (SHA-256) in MariaDB RefreshToken table; they do not use JWT secrets.

# ──────────────────────────────────────────────────────────────────────────────
# SMTP EMAIL SERVICE
# ──────────────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.titan.email
EMAIL_PORT=587
EMAIL_USER=support@wonderfuljodi.com
EMAIL_PASS=your_email_password
EMAIL_FROM="Wonderful Jodi <support@wonderfuljodi.com>"

# ──────────────────────────────────────────────────────────────────────────────
# PAYMENT GATEWAY (RAZORPAY)
# ──────────────────────────────────────────────────────────────────────────────
RAPIDPAY_KEY_ID=rzp_live_your_actual_key_id
RAPIDPAY_KEY_SECRET=your_actual_key_secret

# ──────────────────────────────────────────────────────────────────────────────
# CLOUDINARY (MEDIA STORAGE)
# ──────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
