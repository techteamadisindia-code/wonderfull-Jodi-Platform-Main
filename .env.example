# ==============================================================================
# Wonderful Jodi Doctor Matrimony - Unified Root Environment Configuration
# ==============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=https://wonderfuljodi.com

# ------------------------------------------------------------------------------
# HOSTINGER MYSQL / MARIADB DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=prefer&connection_limit=10
#
# Examples:
#   Hostinger Cloud / Web Hosting:
#     DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@srv1646.hstgr.io:3306/<DB_NAME>?sslmode=prefer&connection_limit=10"
#   Hostinger VPS / Local MariaDB:
#     DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@127.0.0.1:3306/<DB_NAME>?connection_limit=10"
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:3306/<DB_NAME>?sslmode=prefer&connection_limit=10"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate distinct, high-entropy random keys (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_access_token_secret_minimum_32_characters
JWT_REFRESH_SECRET=replace_with_a_distinct_secure_random_refresh_token_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# SMTP EMAIL SERVICE (Required for Forgot Password & Verification Emails)
# ------------------------------------------------------------------------------
# Configure these in Hostinger hPanel -> Node.js Application -> Environment Variables,
# or create backend/.env or root .env in production.
#
# Option A: Hostinger Business Email / Titan Email (Recommended for custom domains):
#   EMAIL_HOST=smtp.titan.email
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=support@yourdomain.com
#   EMAIL_PASS=your_mailbox_password
#   EMAIL_FROM="Wonderful Jodi <support@yourdomain.com>"
#
# Option B: Hostinger Default / cPanel Webmail SMTP:
#   EMAIL_HOST=smtp.hostinger.com
#   EMAIL_PORT=465
#   EMAIL_SECURE=true
#   EMAIL_USER=support@yourdomain.com
#   EMAIL_PASS=your_mailbox_password
#   EMAIL_FROM="Wonderful Jodi <support@yourdomain.com>"
#
# Placeholder variables (supply verified credentials in private .env or hPanel):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (RAZORPAY)
# ------------------------------------------------------------------------------
RAPIDPAY_KEY_ID=your_razorpay_key_id_placeholder
RAPIDPAY_KEY_SECRET=your_razorpay_key_secret_placeholder

# ------------------------------------------------------------------------------
# CLOUDINARY (MEDIA STORAGE)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
