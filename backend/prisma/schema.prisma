// Wonderful Jodi Doctor Matrimony - Complete Hostinger MySQL / MariaDB Prisma Schema
// All 50 entity schemas mapped from MongoDB / Mongoose with exact ObjectId preservation.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────
// 1. AUTH & USER ENTITIES
// ─────────────────────────────────────────────────────────────

model User {
  id                 String    @id @map("_id") @db.VarChar(36)
  fullName           String    @map("full_name") @db.VarChar(150)
  email              String    @unique @db.VarChar(191)
  mobile             String    @unique @db.VarChar(30)
  password           String    @db.VarChar(255)
  role               String    @default("user") @db.VarChar(20) // 'user' | 'admin'
  verified           Boolean   @default(false)
  verificationStatus String    @default("UNVERIFIED") @map("verification_status") @db.VarChar(30) // 'UNVERIFIED' | 'PENDING' | 'VERIFIED' | 'REJECTED'
  isActive           Boolean   @default(true) @map("is_active")
  status             String    @default("Active") @db.VarChar(30) // 'Active' | 'Under Review' | 'Suspended' | 'Blocked' | 'Deleted'
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at")
  deletedById        String?   @map("deleted_by_id") @db.VarChar(36)
  deletionReason     String?   @map("deletion_reason") @db.VarChar(500)
  suspensionReason   String?   @map("suspension_reason") @db.VarChar(500)
  suspendedAt        DateTime? @map("suspended_at")
  suspendedById      String?   @map("suspended_by_id") @db.VarChar(36)
  termsAccepted      Boolean   @default(false) @map("terms_accepted")
  termsVersion       String    @default("2026-09-V1") @map("terms_version") @db.VarChar(50)
  termsAcceptedAt    DateTime? @map("terms_accepted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  profile               Profile?
  adminRecord           Admin?
  subscriptions         Subscription[]
  payments              Payment[]
  sentInterests         Interest[]            @relation("SentInterests")
  receivedInterests     Interest[]            @relation("ReceivedInterests")
  sentMessages          Message[]             @relation("SentMessages")
  receivedMessages      Message[]             @relation("ReceivedMessages")
  notifications         Notification[]
  verifications         Verification[]        @relation("UserVerifications")
  reviewedVerifications Verification[]        @relation("ReviewedVerifications")
  passwordResetTokens   PasswordResetToken[]
  refreshTokens         RefreshToken[]
  securityLogs          SecurityLog[]
  auditLogsAsAdmin      AuditLog[]            @relation("AdminAuditLogs")
  blockedByMe           Block[]               @relation("UserBlocker")
  blockedMe             Block[]               @relation("UserBlocked")
  reportsFiled          Report[]              @relation("ReporterUser")
  reportsAgainst        Report[]              @relation("ReportedUser")
  contactRequestsSent   ContactRequest[]      @relation("SentContactRequests")
  contactRequestsRecv   ContactRequest[]      @relation("ReceivedContactRequests")
  contactAccessLogs     ContactAccessLog[]    @relation("AccessLogUser")
  contactProfileOwner   ContactAccessLog[]    @relation("AccessLogProfileOwner")
  couponRedemptions     CouponRedemption[]
  referralsMade         Referral[]            @relation("ReferrerUser")
  referralsReceived     Referral?             @relation("ReferredUser")
  rewardRecords         ReferralRewardRecord[]
  shortlists            Shortlist[]
  dailyVisits           DailyUserVisit[]
  biodatas              Biodata[]
  kundaliReportsAs1     KundaliReport[]       @relation("KundaliUser1")
  kundaliReportsAs2     KundaliReport[]       @relation("KundaliUser2")
  registrations         Registration[]
  conversations         ConversationParticipant[]

  @@index([role])
  @@index([status])
  @@index([isActive])
  @@index([isDeleted])
  @@index([verificationStatus])
  @@map("users")
}

model Admin {
  id          String   @id @map("_id") @db.VarChar(36)
  userId      String   @unique @map("user_id") @db.VarChar(36)
  permissions Json? // string[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// ─────────────────────────────────────────────────────────────
// 2. PROFILE & REGISTRATION
// ─────────────────────────────────────────────────────────────

model Profile {
  id                        String    @id @map("_id") @db.VarChar(36)
  userId                    String    @unique @map("user_id") @db.VarChar(36)
  candidateId               String?   @unique @map("candidate_id") @db.VarChar(50)
  displayName               String    @map("display_name") @db.VarChar(150)
  gender                    String    @db.VarChar(20) // 'Male' | 'Female' | 'Other'
  dob                       DateTime
  height                    String    @db.VarChar(30)
  maritalStatus             String    @map("marital_status") @db.VarChar(50)
  motherTongue              String?   @default("") @map("mother_tongue") @db.VarChar(100)
  religion                  String?   @default("") @db.VarChar(100)
  caste                     String?   @default("") @db.VarChar(100)
  subCaste                  String?   @map("sub_caste") @db.VarChar(100)
  education                 String    @db.VarChar(150)
  degree                    String    @db.VarChar(150)
  profession                String    @db.VarChar(150)
  company                   String?   @db.VarChar(150)
  workLocation              String?   @map("work_location") @db.VarChar(150)
  annualIncome              String?   @map("annual_income") @db.VarChar(100)
  country                   String    @db.VarChar(100)
  state                     String?   @default("") @db.VarChar(100)
  city                      String    @db.VarChar(100)
  fatherOccupation          String?   @map("father_occupation") @db.VarChar(150)
  motherOccupation          String?   @map("mother_occupation") @db.VarChar(150)
  siblings                  String?   @db.VarChar(150)
  familyType                String?   @map("family_type") @db.VarChar(50)
  foodPreference            String?   @map("food_preference") @db.VarChar(50)
  smoking                   String?   @db.VarChar(50)
  drinking                  String?   @db.VarChar(50)
  hobbies                   Json? // string[]
  about                     String?   @db.Text
  photos                    Json? // string[]
  primaryPhoto              String?   @map("primary_photo") @db.VarChar(500)
  medicalRegistrationNumber String?   @map("medical_registration_number") @db.VarChar(100)
  medicalCouncil            String?   @map("medical_council") @db.VarChar(150)
  registrationState         String?   @map("registration_state") @db.VarChar(100)
  registrationYear          String?   @map("registration_year") @db.VarChar(20)
  medicalExperience         String?   @map("medical_experience") @db.VarChar(100)
  currentHospital           String?   @map("current_hospital") @db.VarChar(200)
  medicalCollege            String?   @map("medical_college") @db.VarChar(200)
  medicalUniversity         String?   @map("medical_university") @db.VarChar(200)
  graduationYear            String?   @map("graduation_year") @db.VarChar(20)
  additionalQualification   String?   @map("additional_qualification") @db.VarChar(200)
  currentRole               String?   @map("current_role") @db.VarChar(150)
  workType                  String?   @map("work_type") @db.VarChar(100)
  currentlyPracticing       Boolean?  @default(true) @map("currently_practicing")
  familyStatus              String?   @map("family_status") @db.VarChar(100)
  familyValues              String?   @map("family_values") @db.VarChar(100)
  nativePlace               String?   @map("native_place") @db.VarChar(150)
  familyLocation            String?   @map("family_location") @db.VarChar(150)
  profileManagedBy          String?   @default("Self") @map("profile_managed_by") @db.VarChar(50)
  currentLocation           Json? // { countryId, stateId, districtId, subDistrictId, cityId, villageId, pincode, formattedAddress }
  nativePlaceDetails        Json? // { countryId, stateId, districtId, subDistrictId, cityId, villageId, pincode, description, formattedAddress }
  communityDetails          Json? // { religionId, casteId, subCasteId, casteCategory, subCasteText }
  languageDetails           Json? // { motherTongueId, otherLanguagesIds }
  horoscope                 Json? // { timeOfBirth, placeOfBirth, rashi, nakshatra, lagna, manglik, gotra, horoscopeDocument, pada, birthPlaceDetails }
  lifestyleInterests        Json? // { diet, alcohol, smoking, exercise, hobbies, travel, music, reading, sports, languages, pets, otherInterests }
  partnerExpectations       Json? // { ageMin, ageMax, heightMin, heightMax, qualification, specialization, location, willingToRelocate, maritalStatus, lifestyle, familyExpectations, additionalExpectations }
  partnerPreferences        Json? // { preferredAgeMin, preferredAgeMax, preferredLocation, preferredQualification, preferredSpecialization, preferredMaritalStatus, otherPreferences }
  aboutMe                   String?   @map("about_me") @db.Text
  personalityValues         String?   @map("personality_values") @db.Text
  hobbiesInterests          String?   @map("hobbies_interests") @db.Text
  careerGoals               String?   @map("career_goals") @db.Text
  familyBackground          Json? // { familyType, familyStatus, fatherName, fatherProfession, motherName, motherProfession, familyLocation, familyValues, aboutFamily }
  siblingsDetails           Json? // { brothersCount, sistersCount, brothers, sisters }
  medicalQualifications     Json? // { undergraduate, postgraduate, doctorate }
  privacySettings           Json? // { profileVisibility, photoVisibility, contactVisibility, whoCanSendInterest, whoCanMessage, horoscopeVisibility, birthDateVisibility, birthTimeVisibility, birthPlaceVisibility, kundaliVisibility, nameVisibility }
  verificationStatus        String    @default("UNVERIFIED") @map("verification_status") @db.VarChar(30)
  status                    String    @default("Active") @db.VarChar(30)
  statusReason              String?   @map("status_reason") @db.VarChar(500)
  statusChangedAt           DateTime? @map("status_changed_at")
  statusChangedById         String?   @map("status_changed_by_id") @db.VarChar(36)
  isDeleted                 Boolean   @default(false) @map("is_deleted")
  deletedAt                 DateTime? @map("deleted_at")
  deletedById               String?   @map("deleted_by_id") @db.VarChar(36)
  deletionReason            String?   @map("deletion_reason") @db.VarChar(500)
  lastActiveAt              DateTime  @default(now()) @map("last_active_at")
  adminNotes                Json? // { note, adminId, adminEmail, adminName, createdAt }[]
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderInterests      Interest[]       @relation("SenderProfile")
  receiverInterests    Interest[]       @relation("ReceiverProfile")
  shortlistedIn        Shortlist[]
  biodatas             Biodata[]
  registrations        Registration[]
  kundaliAsPartner1    KundaliReport[]  @relation("KundaliPartner1")
  kundaliAsPartner2    KundaliReport[]  @relation("KundaliPartner2")
  reportedInReports    Report[]

  @@index([gender, city, religion, caste, education, profession])
  @@index([status])
  @@index([isDeleted])
  @@index([verificationStatus])
  @@map("profiles")
}

model Registration {
  id                   String    @id @map("_id") @db.VarChar(36)
  registrationId       String    @unique @map("registration_id") @db.VarChar(50)
  status               String    @default("IN_PROGRESS") @db.VarChar(30) // 'STARTED' | 'IN_PROGRESS' | 'COMPLETED' | 'ABANDONED'
  currentStep          Int       @default(1) @map("current_step")
  totalSteps           Int       @default(4) @map("total_steps")
  completionPercentage Int       @default(0) @map("completion_percentage")
  candidateName        String    @map("candidate_name") @db.VarChar(150)
  email                String?   @db.VarChar(191)
  mobile               String?   @db.VarChar(30)
  gender               String?   @db.VarChar(20)
  stepData             Json      @map("step_data")
  userId               String?   @map("user_id") @db.VarChar(36)
  profileId            String?   @map("profile_id") @db.VarChar(36)
  resumeToken          String?   @map("resume_token") @db.VarChar(100)
  startedAt            DateTime  @default(now()) @map("started_at")
  lastActiveAt         DateTime  @default(now()) @map("last_active_at")
  completedAt          DateTime? @map("completed_at")
  abandonedAt          DateTime? @map("abandoned_at")
  ipAddress            String?   @map("ip_address") @db.VarChar(50)
  userAgent            String?   @map("user_agent") @db.VarChar(500)
  isDeleted            Boolean   @default(false) @map("is_deleted")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([mobile])
  @@index([isDeleted])
  @@map("registrations")
}

// ─────────────────────────────────────────────────────────────
// 3. MEMBERSHIP & PAYMENTS
// ─────────────────────────────────────────────────────────────

model MembershipPlan {
  id                  String   @id @map("_id") @db.VarChar(36)
  name                String   @db.VarChar(100)
  slug                String   @unique @db.VarChar(100)
  key                 String?  @db.VarChar(100)
  planId              String?  @map("plan_id") @db.VarChar(100)
  description         String?  @default("") @db.VarChar(500)
  originalPrice       Float    @default(0) @map("original_price")
  discountedPrice     Float    @default(0) @map("discounted_price")
  price               Float    @default(0)
  currency            String   @default("INR") @db.VarChar(10)
  billingPeriod       String   @default("Monthly") @map("billing_period") @db.VarChar(50)
  durationDays        Int      @default(30) @map("duration_days")
  durationMonths      Int?     @map("duration_months")
  features            Json? // string[]
  isActive            Boolean  @default(true) @map("is_active")
  isPopular           Boolean  @default(false) @map("is_popular")
  displayOrder        Int      @default(1) @map("display_order")
  seasonalLabel       String?  @default("") @map("seasonal_label") @db.VarChar(100)
  seasonalDiscount    Float?   @default(0) @map("seasonal_discount")
  isSeasonalOffer     Boolean  @default(false) @map("is_seasonal_offer")
  badge               String?  @default("") @db.VarChar(100)
  bestFor             String?  @default("") @map("best_for") @db.VarChar(150)
  profileViewLimit    String   @default("limited") @map("profile_view_limit") @db.VarChar(20) // 'limited' | 'unlimited'
  contactRequestLimit Int      @default(0) @map("contact_request_limit")
  isUnlimitedContact  Boolean  @default(false) @map("is_unlimited_contact")
  fairUsageEnabled    Boolean  @default(false) @map("fair_usage_enabled")
  ctaText             String   @default("Select Plan") @map("cta_text") @db.VarChar(100)
  ctaAction           String   @default("order") @map("cta_action") @db.VarChar(20) // 'register' | 'order' | 'contact'
  disclaimer          String?  @default("") @db.VarChar(500)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([displayOrder])
  @@map("membership_plans")
}

model Subscription {
  id                       String    @id @map("_id") @db.VarChar(36)
  userId                   String    @map("user_id") @db.VarChar(36)
  plan                     String    @db.VarChar(100)
  planId                   String?   @map("plan_id") @db.VarChar(100)
  status                   String    @default("ACTIVE") @db.VarChar(20) // 'ACTIVE' | 'PENDING' | 'EXPIRED' | 'CANCELLED'
  startDate                DateTime  @map("start_date")
  expiryDate               DateTime? @map("expiry_date")
  contactRequestsUsed      Int       @default(0) @map("contact_requests_used")
  contactRequestsRemaining Int       @default(0) @map("contact_requests_remaining")
  paymentReference         String?   @map("payment_reference") @db.VarChar(150)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([plan])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String    @id @map("_id") @db.VarChar(36)
  userId            String    @map("user_id") @db.VarChar(36)
  subscriptionId    String?   @map("subscription_id") @db.VarChar(36)
  orderId           String?   @map("order_id") @db.VarChar(150)
  paymentId         String?   @map("payment_id") @db.VarChar(150)
  provider          String    @default("razorpay") @db.VarChar(50)
  providerPaymentId String    @map("provider_payment_id") @db.VarChar(150)
  amount            Float
  currency          String    @default("INR") @db.VarChar(10)
  planId            String?   @map("plan_id") @db.VarChar(100)
  planName          String?   @map("plan_name") @db.VarChar(150)
  paymentMethod     String?   @default("UPI") @map("payment_method") @db.VarChar(50)
  status            String    @default("PENDING") @db.VarChar(30) // 'PENDING' | 'SUCCESS' | 'FAILED' | 'CANCELLED' | 'REFUNDED' | 'PARTIALLY_REFUNDED'
  receipt           String?   @db.VarChar(150)
  razorpaySignature String?   @map("razorpay_signature") @db.VarChar(255)
  failureReason     String?   @map("failure_reason") @db.Text
  refundId          String?   @map("refund_id") @db.VarChar(150)
  refundAmount      Float?    @default(0) @map("refund_amount")
  refundStatus      String?   @default("NONE") @map("refund_status") @db.VarChar(30) // 'NONE' | 'PENDING' | 'PROCESSED' | 'FAILED'
  refundReason      String?   @map("refund_reason") @db.Text
  refundedAt        DateTime? @map("refunded_at")
  isSimulated       Boolean   @default(false) @map("is_simulated")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([paymentId])
  @@index([providerPaymentId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// 4. MATCHMAKING & CHAT
// ─────────────────────────────────────────────────────────────

model Interest {
  id                String   @id @map("_id") @db.VarChar(36)
  senderId          String   @map("sender_id") @db.VarChar(36)
  receiverId        String   @map("receiver_id") @db.VarChar(36)
  senderProfileId   String?  @map("sender_profile_id") @db.VarChar(36)
  receiverProfileId String?  @map("receiver_profile_id") @db.VarChar(36)
  status            String   @default("PENDING") @db.VarChar(20) // 'PENDING' | 'ACCEPTED' | 'DECLINED' | 'REJECTED' | 'CANCELLED'
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sender          User          @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User          @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)
  senderProfile   Profile?      @relation("SenderProfile", fields: [senderProfileId], references: [id], onDelete: SetNull)
  receiverProfile Profile?      @relation("ReceiverProfile", fields: [receiverProfileId], references: [id], onDelete: SetNull)
  conversations   Conversation[]

  @@unique([senderId, receiverId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("interests")
}

model Shortlist {
  id        String   @id @map("_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  profileId String   @map("profile_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@map("shortlists")
}

model Conversation {
  id               String   @id @map("_id") @db.VarChar(36)
  interestId       String?  @map("interest_id") @db.VarChar(36)
  lastMessage      String?  @map("last_message") @db.Text
  messageCount     Int      @default(0) @map("message_count")
  status           String   @default("ACTIVE") @db.VarChar(20) // 'ACTIVE' | 'FLAGGED' | 'BLOCKED' | 'ARCHIVED'
  complianceStatus String   @default("SAFE") @map("compliance_status") @db.VarChar(20) // 'SAFE' | 'FLAGGED' | 'UNDER_REVIEW' | 'BLOCKED'
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  interest     Interest?                 @relation(fields: [interestId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastActivityAt])
  @@index([updatedAt])
  @@index([status, complianceStatus])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @map("conversation_id") @db.VarChar(36)
  userId         String @map("user_id") @db.VarChar(36)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id                   String    @id @map("_id") @db.VarChar(36)
  conversationId       String    @map("conversation_id") @db.VarChar(36)
  senderId             String    @map("sender_id") @db.VarChar(36)
  receiverId           String    @map("receiver_id") @db.VarChar(36)
  content              String    @db.Text
  read                 Boolean   @default(false)
  moderationStatus     String    @default("SAFE") @map("moderation_status") @db.VarChar(20) // 'SAFE' | 'FLAGGED' | 'UNDER_REVIEW' | 'BLOCKED'
  moderationCategory   String?   @default("NONE") @map("moderation_category") @db.VarChar(30)
  moderationConfidence String?   @default("NONE") @map("moderation_confidence") @db.VarChar(20)
  moderationScore      Float?    @default(0) @map("moderation_score")
  flaggedReason        String?   @map("flagged_reason") @db.VarChar(255)
  moderatedAt          DateTime? @default(now()) @map("moderated_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, receiverId])
  @@index([moderationStatus, moderationCategory])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// 5. NOTIFICATIONS & BROADCASTS
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @map("_id") @db.VarChar(36)
  userId      String    @map("user_id") @db.VarChar(36)
  broadcastId String?   @map("broadcast_id") @db.VarChar(36)
  type        String    @default("SYSTEM") @db.VarChar(50)
  title       String    @db.VarChar(150)
  message     String    @db.Text
  actionUrl   String?   @map("action_url") @db.VarChar(500)
  link        String?   @db.VarChar(500)
  read        Boolean   @default(false)
  readAt      DateTime? @map("read_at")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Broadcast {
  id              String    @id @map("_id") @db.VarChar(36)
  title           String    @db.VarChar(150)
  message         String    @db.Text
  type            String    @default("SYSTEM") @db.VarChar(30)
  targetType      String    @default("ALL_USERS") @map("target_type") @db.VarChar(30)
  targetUserIds   Json?     @map("target_user_ids") // string[]
  actionUrl       String?   @map("action_url") @db.VarChar(500)
  createdById     String    @map("created_by_id") @db.VarChar(36)
