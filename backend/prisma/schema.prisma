// Wonderful Jodi Doctor Matrimony - Complete Hostinger MySQL / MariaDB Prisma Schema
// All 50 entity schemas mapped from MongoDB / Mongoose with exact ObjectId preservation.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────
// 1. AUTH & USER ENTITIES
// ─────────────────────────────────────────────────────────────

model User {
  id                 String    @id @map("_id") @db.VarChar(36)
  fullName           String    @map("fullName") @db.VarChar(150)
  email              String    @unique @db.VarChar(191)
  mobile             String    @unique @db.VarChar(30)
  password           String    @db.VarChar(255)
  role               String?   @default("user") @db.VarChar(20) // 'user' | 'admin'
  verified           Boolean?  @default(false)
  verificationStatus String?   @default("UNVERIFIED") @map("verificationStatus") @db.VarChar(30) // 'UNVERIFIED' | 'PENDING' | 'VERIFIED' | 'REJECTED'
  isActive           Boolean?  @default(true) @map("isActive")
  status             String?   @default("Active") @db.VarChar(30) // 'Active' | 'Under Review' | 'Suspended' | 'Blocked' | 'Deleted'
  isDeleted          Boolean?  @default(false) @map("isDeleted")
  termsAccepted      Boolean?  @default(false) @map("termsAccepted")
  termsVersion       String?   @default("2026-09-V1") @map("termsVersion") @db.VarChar(50)
  termsAcceptedAt    DateTime? @map("termsAcceptedAt")
  createdAt          DateTime  @default(now()) @map("createdAt")
  updatedAt          DateTime  @updatedAt @map("updatedAt")

  profile               Profile?
  adminRecord           Admin?
  subscriptions         Subscription[]
  payments              Payment[]
  sentInterests         Interest[]            @relation("SentInterests")
  receivedInterests     Interest[]            @relation("ReceivedInterests")
  sentMessages          Message[]             @relation("SentMessages")
  receivedMessages      Message[]             @relation("ReceivedMessages")
  notifications         Notification[]
  verifications         Verification[]        @relation("UserVerifications")
  reviewedVerifications Verification[]        @relation("ReviewedVerifications")
  passwordResetTokens   PasswordResetToken[]
  refreshTokens         RefreshToken[]
  securityLogs          SecurityLog[]
  auditLogsAsAdmin      AuditLog[]            @relation("AdminAuditLogs")
  blockedByMe           Block[]               @relation("UserBlocker")
  blockedMe             Block[]               @relation("UserBlocked")
  reportsFiled          Report[]              @relation("ReporterUser")
  reportsAgainst        Report[]              @relation("ReportedUser")
  contactRequestsSent   ContactRequest[]      @relation("SentContactRequests")
  contactRequestsRecv   ContactRequest[]      @relation("ReceivedContactRequests")
  contactAccessLogs     ContactAccessLog[]    @relation("AccessLogUser")
  contactProfileOwner   ContactAccessLog[]    @relation("AccessLogProfileOwner")
  couponRedemptions     CouponRedemption[]
  referralsMade         Referral[]            @relation("ReferrerUser")
  referralsReceived     Referral?             @relation("ReferredUser")
  rewardRecords         ReferralRewardRecord[]
  shortlists            Shortlist[]
  dailyVisits           DailyUserVisit[]
  biodatas              Biodata[]
  kundaliReportsAs1     KundaliReport[]       @relation("KundaliUser1")
  kundaliReportsAs2     KundaliReport[]       @relation("KundaliUser2")
  registrations         Registration[]
  conversations         ConversationParticipant[]

  @@index([role])
  @@index([status])
  @@index([isActive])
  @@index([isDeleted])
  @@index([verificationStatus])
  @@map("users")
}

model Admin {
  id          String   @id @map("id") @db.VarChar(36)
  userId      String   @unique @map("user_id") @db.VarChar(36)
  permissions Json? // string[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// ─────────────────────────────────────────────────────────────
// 2. PROFILE & REGISTRATION
// ─────────────────────────────────────────────────────────────

model Profile {
  id                        String    @id @map("_id") @db.VarChar(36)
  userId                    String    @unique @map("user") @db.VarChar(36)
  candidateId               String?   @unique @map("candidateId") @db.VarChar(50)
  displayName               String    @map("displayName") @db.VarChar(150)
  gender                    String    @db.VarChar(20) // 'Male' | 'Female' | 'Other'
  dob                       DateTime
  height                    String    @db.VarChar(30)
  maritalStatus             String    @map("maritalStatus") @db.VarChar(50)
  motherTongue              String?   @default("") @map("motherTongue") @db.VarChar(100)
  religion                  String?   @default("") @db.VarChar(100)
  caste                     String?   @default("") @db.VarChar(100)
  subCaste                  String?   @map("subCaste") @db.VarChar(100)
  education                 String    @db.VarChar(150)
  degree                    String    @db.VarChar(150)
  profession                String    @db.VarChar(150)
  company                   String?   @db.VarChar(150)
  workLocation              String?   @map("workLocation") @db.VarChar(150)
  annualIncome              String?   @map("annualIncome") @db.VarChar(100)
  country                   String    @db.VarChar(100)
  state                     String?   @default("") @db.VarChar(100)
  city                      String    @db.VarChar(100)
  fatherOccupation          String?   @map("fatherOccupation") @db.VarChar(150)
  motherOccupation          String?   @map("motherOccupation") @db.VarChar(150)
  siblings                  String?   @db.VarChar(150)
  familyType                String?   @map("familyType") @db.VarChar(50)
  foodPreference            String?   @map("foodPreference") @db.VarChar(50)
  smoking                   String?   @db.VarChar(50)
  drinking                  String?   @db.VarChar(50)
  hobbies                   Json? // string[]
  about                     String?   @db.Text
  photos                    Json? // string[]
  primaryPhoto              String?   @map("primaryPhoto") @db.VarChar(500)
  medicalRegistrationNumber String?   @map("medicalRegistrationNumber") @db.VarChar(100)
  medicalCouncil            String?   @map("medicalCouncil") @db.VarChar(150)
  registrationState         String?   @map("registrationState") @db.VarChar(100)
  registrationYear          String?   @map("registrationYear") @db.VarChar(20)
  medicalExperience         String?   @map("medicalExperience") @db.VarChar(100)
  currentHospital           String?   @map("currentHospital") @db.VarChar(200)
  medicalCollege            String?   @map("medicalCollege") @db.VarChar(200)
  medicalUniversity         String?   @map("medicalUniversity") @db.VarChar(200)
  graduationYear            String?   @map("graduationYear") @db.VarChar(20)
  additionalQualification   String?   @map("additionalQualification") @db.VarChar(200)
  currentRole               String?   @map("currentRole") @db.VarChar(150)
  workType                  String?   @map("workType") @db.VarChar(100)
  currentlyPracticing       Boolean?  @default(true) @map("currentlyPracticing")
  familyStatus              String?   @map("familyStatus") @db.VarChar(100)
  familyValues              String?   @map("familyValues") @db.VarChar(100)
  nativePlace               String?   @map("nativePlace") @db.VarChar(150)
  familyLocation            String?   @map("familyLocation") @db.VarChar(150)
  profileManagedBy          String?   @default("Self") @map("profileManagedBy") @db.VarChar(50)
  currentLocation           Json? // { countryId, stateId, districtId, subDistrictId, cityId, villageId, pincode, formattedAddress }
  nativePlaceDetails        Json? // { countryId, stateId, districtId, subDistrictId, cityId, villageId, pincode, description, formattedAddress }
  communityDetails          Json? // { religionId, casteId, subCasteId, casteCategory, subCasteText }
  languageDetails           Json? // { motherTongueId, otherLanguagesIds }
  horoscope                 Json? // { timeOfBirth, placeOfBirth, rashi, nakshatra, lagna, manglik, gotra, horoscopeDocument, pada, birthPlaceDetails }
  lifestyleInterests        Json? // { diet, alcohol, smoking, exercise, hobbies, travel, music, reading, sports, languages, pets, otherInterests }
  partnerExpectations       Json? // { ageMin, ageMax, heightMin, heightMax, qualification, specialization, location, willingToRelocate, maritalStatus, lifestyle, familyExpectations, additionalExpectations }
  partnerPreferences        Json? // { preferredAgeMin, preferredAgeMax, preferredLocation, preferredQualification, preferredSpecialization, preferredMaritalStatus, otherPreferences }
  aboutMe                   String?   @map("aboutMe") @db.Text
  personalityValues         String?   @map("personalityValues") @db.Text
  hobbiesInterests          String?   @map("hobbiesInterests") @db.Text
  careerGoals               String?   @map("careerGoals") @db.Text
  familyBackground          Json? // { familyType, familyStatus, fatherName, fatherProfession, motherName, motherProfession, familyLocation, familyValues, aboutFamily }
  siblingsDetails           Json? // { brothersCount, sistersCount, brothers, sisters }
  medicalQualifications     Json? // { undergraduate, postgraduate, doctorate }
  privacySettings           Json? // { profileVisibility, photoVisibility, contactVisibility, whoCanSendInterest, whoCanMessage, horoscopeVisibility, birthDateVisibility, birthTimeVisibility, birthPlaceVisibility, kundaliVisibility, nameVisibility }
  verificationStatus        String?   @default("UNVERIFIED") @map("verificationStatus") @db.VarChar(30)
  status                    String?   @default("Active") @db.VarChar(30)
  isDeleted                 Boolean?  @default(false) @map("isDeleted")
  lastActiveAt              DateTime? @default(now()) @map("lastActiveAt")
  adminNotes                Json? // { note, adminId, adminEmail, adminName, createdAt }[]
  createdAt                 DateTime  @default(now()) @map("createdAt")
  updatedAt                 DateTime  @updatedAt @map("updatedAt")

  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderInterests      Interest[]       @relation("SenderProfile")
  receiverInterests    Interest[]       @relation("ReceiverProfile")
  shortlistedIn        Shortlist[]
  biodatas             Biodata[]
  registrations        Registration[]
  kundaliAsPartner1    KundaliReport[]  @relation("KundaliPartner1")
  kundaliAsPartner2    KundaliReport[]  @relation("KundaliPartner2")
  reportedInReports    Report[]

  @@index([gender, city, religion, caste, education, profession])
  @@index([status])
  @@index([isDeleted])
  @@index([verificationStatus])
  @@map("profiles")
}

model Registration {
  id                   String    @id @map("_id") @db.VarChar(36)
  registrationId       String    @unique @map("registrationId") @db.VarChar(50)
  status               String    @default("IN_PROGRESS") @db.VarChar(30) // 'STARTED' | 'IN_PROGRESS' | 'COMPLETED' | 'ABANDONED'
  currentStep          Int       @default(1) @map("currentStep")
  totalSteps           Int       @default(4) @map("totalSteps")
  completionPercentage Int       @default(0) @map("completionPercentage")
  candidateName        String    @map("candidateName") @db.VarChar(150)
  email                String?   @db.VarChar(191)
  mobile               String?   @db.VarChar(30)
  gender               String?   @db.VarChar(20)
  stepData             Json      @map("stepData")
  userId               String?   @map("user") @db.VarChar(36)
  profileId            String?   @map("profile") @db.VarChar(36)
  resumeToken          String?   @map("resumeToken") @db.VarChar(100)
  startedAt            DateTime  @default(now()) @map("startedAt")
  lastActiveAt         DateTime  @default(now()) @map("lastActiveAt")
  completedAt          DateTime? @map("completedAt")
  // abandonedAt          DateTime? @map("abandoned_at")
  ipAddress            String?   @map("ipAddress") @db.VarChar(50)
  userAgent            String?   @map("userAgent") @db.VarChar(500)
  isDeleted            Boolean?   @default(false) @map("isDeleted")
  createdAt            DateTime  @default(now()) @map("createdAt")
  updatedAt            DateTime  @updatedAt @map("updatedAt")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([mobile])
  @@index([isDeleted])
  @@map("registrations")
}

// ─────────────────────────────────────────────────────────────
// 3. MEMBERSHIP & PAYMENTS
// ─────────────────────────────────────────────────────────────

model MembershipPlan {
  id                  String   @id @map("_id") @db.VarChar(36)
  name                String   @db.VarChar(100)
  slug                String   @unique @db.VarChar(100)
  key                 String?  @db.VarChar(100)
  planId              String?  @map("planId") @db.VarChar(100)
  description         String?  @default("") @db.VarChar(500)
  originalPrice       Float    @default(0) @map("originalPrice")
  discountedPrice     Float    @default(0) @map("discountedPrice")
  price               Float    @default(0)
  currency            String   @default("INR") @db.VarChar(10)
  billingPeriod       String   @default("Monthly") @map("billingPeriod") @db.VarChar(50)
  durationDays        Int      @default(30) @map("durationDays")
  durationMonths      Int?     @map("durationMonths")
  features            Json? // string[]
  isActive            Boolean  @default(true) @map("isActive")
  isPopular           Boolean  @default(false) @map("isPopular")
  displayOrder        Int      @default(1) @map("displayOrder")
  seasonalLabel       String?  @default("") @map("seasonalLabel") @db.VarChar(100)
  seasonalDiscount    Float?   @default(0) @map("seasonalDiscount")
  isSeasonalOffer     Boolean  @default(false) @map("isSeasonalOffer")
  badge               String?  @default("") @db.VarChar(100)
  bestFor             String?  @default("") @map("bestFor") @db.VarChar(150)
  profileViewLimit    String   @default("limited") @map("profileViewLimit") @db.VarChar(20) // 'limited' | 'unlimited'
  contactRequestLimit Int      @default(0) @map("contactRequestLimit")
  isUnlimitedContact  Boolean  @default(false) @map("isUnlimitedContact")
  fairUsageEnabled    Boolean  @default(false) @map("fairUsageEnabled")
  ctaText             String   @default("Select Plan") @map("ctaText") @db.VarChar(100)
  ctaAction           String   @default("order") @map("ctaAction") @db.VarChar(20) // 'register' | 'order' | 'contact'
  disclaimer          String?  @default("") @db.VarChar(500)
  createdAt           DateTime @default(now()) @map("createdAt")
  updatedAt           DateTime @updatedAt @map("updatedAt")

  @@index([isActive])
  @@index([displayOrder])
  @@map("membershipplans")
}

model Subscription {
  id                       String    @id @map("_id") @db.VarChar(36)
  userId                   String    @map("user") @db.VarChar(36)
  plan                     String    @db.VarChar(100)
  planId                   String?   @map("planId") @db.VarChar(100)
  status                   String    @default("ACTIVE") @db.VarChar(20) // 'ACTIVE' | 'PENDING' | 'EXPIRED' | 'CANCELLED'
  startDate                DateTime  @map("startDate")
  expiryDate               DateTime? @map("expiryDate")
  contactRequestsUsed       Int?      @default(0) @map("contactRequestsUsed")
  contactRequestsRemaining Int?       @default(0) @map("contactRequestsRemaining")
  paymentReference         String?   @map("paymentReference") @db.VarChar(150)
  createdAt                DateTime  @default(now()) @map("createdAt")
  updatedAt                DateTime  @updatedAt @map("updatedAt")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([plan])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String    @id @map("_id") @db.VarChar(36)
  userId            String    @map("user") @db.VarChar(36)
  subscriptionId    String?   @map("subscription") @db.VarChar(36)
  orderId           String?   @map("orderId") @db.VarChar(150)
  paymentId         String?   @map("paymentId") @db.VarChar(150)
  provider          String    @default("razorpay") @db.VarChar(50)
  providerPaymentId String    @map("providerPaymentId") @db.VarChar(150)
  amount            Float
  currency          String    @default("INR") @db.VarChar(10)
  planId            String?   @map("planId") @db.VarChar(100)
  planName          String?   @map("planName") @db.VarChar(150)
  paymentMethod     String?   @default("UPI") @map("paymentMethod") @db.VarChar(50)
  status            String    @default("PENDING") @db.VarChar(30) // 'PENDING' | 'SUCCESS' | 'FAILED' | 'CANCELLED' | 'REFUNDED' | 'PARTIALLY_REFUNDED'
  receipt           String?   @db.VarChar(150)
  // razorpaySignature String?   @map("razorpay_signature") @db.VarChar(255)
  failureReason     String?   @map("failureReason") @db.Text
  refundId          String?   @map("refundId") @db.VarChar(150)
  refundAmount      Float?    @default(0) @map("refundAmount")
  refundStatus      String?   @default("NONE") @map("refundStatus") @db.VarChar(30) // 'NONE' | 'PENDING' | 'PROCESSED' | 'FAILED'
  refundReason      String?   @map("refundReason") @db.Text
  refundedAt        DateTime? @map("refundedAt")
  isSimulated       Boolean?   @default(false) @map("isSimulated")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("createdAt")
  updatedAt         DateTime  @updatedAt @map("updatedAt")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([paymentId])
  @@index([providerPaymentId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// 4. MATCHMAKING & CHAT
// ─────────────────────────────────────────────────────────────

model Interest {
  id                String   @id @map("_id") @db.VarChar(36)
  senderId          String   @map("sender") @db.VarChar(36)
  receiverId        String   @map("receiver") @db.VarChar(36)
  senderProfileId   String?  @map("senderProfile") @db.VarChar(36)
  receiverProfileId String?  @map("receiverProfile") @db.VarChar(36)
  status            String   @default("PENDING") @db.VarChar(20) // 'PENDING' | 'ACCEPTED' | 'DECLINED' | 'REJECTED' | 'CANCELLED'
  createdAt         DateTime @default(now()) @map("createdAt")
  updatedAt         DateTime @updatedAt @map("updatedAt")

  sender          User          @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User          @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)
  senderProfile   Profile?      @relation("SenderProfile", fields: [senderProfileId], references: [id], onDelete: SetNull)
  receiverProfile Profile?      @relation("ReceiverProfile", fields: [receiverProfileId], references: [id], onDelete: SetNull)
  conversations   Conversation[]

  @@unique([senderId, receiverId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("interests")
}

model Shortlist {
  id        String   @id @map("_id") @db.VarChar(36)
  userId    String   @map("user") @db.VarChar(36)
  profileId String   @map("profile") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@map("shortlists")
}

model Conversation {
  id               String   @id @map("_id") @db.VarChar(36)
  interestId       String?  @map("interest") @db.VarChar(36)
  lastMessage      String?  @map("lastMessage") @db.Text
  messageCount     Int      @default(0) @map("messageCount")
  status           String   @default("ACTIVE") @db.VarChar(20) // 'ACTIVE' | 'FLAGGED' | 'BLOCKED' | 'ARCHIVED'
  complianceStatus String   @default("SAFE") @map("complianceStatus") @db.VarChar(20) // 'SAFE' | 'FLAGGED' | 'UNDER_REVIEW' | 'BLOCKED'
  lastActivityAt   DateTime @default(now()) @map("lastActivityAt")
  createdAt        DateTime @default(now()) @map("createdAt")
  updatedAt        DateTime @updatedAt @map("updatedAt")

  interest     Interest?                 @relation(fields: [interestId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastActivityAt])
  @@index([updatedAt])
  @@index([status, complianceStatus])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @map("conversation_id") @db.VarChar(36)
  userId         String @map("user_id") @db.VarChar(36)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id                   String    @id @map("_id") @db.VarChar(36)
  conversationId       String    @map("conversation") @db.VarChar(36)
  senderId             String    @map("sender") @db.VarChar(36)
  receiverId           String    @map("receiver") @db.VarChar(36)
  content              String    @db.Text
  read                 Boolean   @default(false)
  moderationStatus     String    @default("SAFE") @map("moderationStatus") @db.VarChar(20) // 'SAFE' | 'FLAGGED' | 'UNDER_REVIEW' | 'BLOCKED'
  moderationCategory   String?   @default("NONE") @map("moderationCategory") @db.VarChar(30)
  moderationConfidence String?   @default("NONE") @map("moderationConfidence") @db.VarChar(20)
  moderationScore      Float?    @default(0) @map("moderationScore")
  flaggedReason        String?   @map("flaggedReason") @db.VarChar(255)
  moderatedAt          DateTime? @default(now()) @map("moderatedAt")
  createdAt            DateTime  @default(now()) @map("createdAt")
  updatedAt            DateTime  @updatedAt @map("updatedAt")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, receiverId])
  @@index([moderationStatus, moderationCategory])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────
// 5. NOTIFICATIONS & BROADCASTS
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @map("_id") @db.VarChar(36)
  userId      String    @map("user") @db.VarChar(36)
  broadcastId String?   @map("broadcast") @db.VarChar(36)
  type        String    @default("SYSTEM") @db.VarChar(50)
  title       String    @db.VarChar(150)
  message     String    @db.Text
  actionUrl   String?   @map("actionUrl") @db.VarChar(500)
  link        String?   @db.VarChar(500)
  read        Boolean   @default(false)
  readAt      DateTime? @map("readAt")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("createdAt")
  updatedAt   DateTime  @updatedAt @map("updatedAt")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Broadcast {
  id              String    @id @map("id") @db.VarChar(36)
  title           String    @db.VarChar(150)
  message         String    @db.Text
  type            String    @default("SYSTEM") @db.VarChar(30)
  targetType      String    @default("ALL_USERS") @map("target_type") @db.VarChar(30)
  targetUserIds   Json?     @map("target_user_ids") // string[]
  actionUrl       String?   @map("action_url") @db.VarChar(500)
  createdById     String    @map("created_by") @db.VarChar(36)
  status          String    @default("SENT") @db.VarChar(20) // 'DRAFT' | 'QUEUED' | 'SENDING' | 'SENT' | 'FAILED'
  totalRecipients Int       @default(0) @map("total_recipients")
  deliveredCount  Int       @default(0) @map("delivered_count")
  readCount       Int       @default(0) @map("read_count")
  sentAt          DateTime? @default(now()) @map("sent_at")
  // metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  notifications Notification[]

  @@index([createdAt])
  @@map("broadcasts")
}

// ─────────────────────────────────────────────────────────────
// 6. VERIFICATION, AUDIT & SECURITY
// ─────────────────────────────────────────────────────────────

model Verification {
  id              String    @id @map("_id") @db.VarChar(36)
  userId          String    @map("user") @db.VarChar(36)
  documentType    String    @map("documentType") @db.VarChar(50)
  documentName    String?   @default("Verification Document") @map("documentName") @db.VarChar(150)
  documentUrl     String    @map("documentUrl") @db.VarChar(500)
  storageKey      String?   @map("storageKey") @db.VarChar(255)
  fileType        String?   @default("application/pdf") @map("fileType") @db.VarChar(50)
  fileSize        Int?      @default(0) @map("fileSize")
