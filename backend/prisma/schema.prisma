model Campaign {
  id                 String   @id @map("_id") @db.VarChar(36)
  campaignName       String   @map("campaign_name") @db.VarChar(150)
  description        String?  @db.Text
  startDate          DateTime @map("start_date")
  endDate            DateTime @map("end_date")
  timezone           String   @default("Asia/Kolkata") @db.VarChar(50)
  priority           Int      @default(0)
  targetGender       String   @default("Any") @map("target_gender") @db.VarChar(20)
  minAge             Int?     @map("min_age")
  maxAge             Int?     @map("max_age")
  maritalStatus      Json?    @map("marital_status") // string[]
  membershipType     Json?    @map("membership_type") // string[]
  registrationStatus String?  @default("Any") @map("registration_status") @db.VarChar(50)
  verificationStatus String?  @default("Any") @map("verification_status") @db.VarChar(50)
  profileStatus      String?  @default("Any") @map("profile_status") @db.VarChar(50)
  location           Json? // { countries, states, districts, cities }
  qualification      Json? // string[]
  specialization     Json? // string[]
  applicablePlans    Json?    @map("applicable_plans") // string[]
  discountType       String   @default("PERCENTAGE") @map("discount_type") @db.VarChar(30)
  discountValue      Float    @default(0) @map("discount_value")
  couponRequired     Boolean  @default(false) @map("coupon_required")
  couponCode         String?  @map("coupon_code") @db.VarChar(50)
  usageLimit         Int      @default(0) @map("usage_limit")
  usedCount          Int      @default(0) @map("used_count")
  genderUsageLimit   Json?    @map("gender_usage_limit")
  perMemberLimit     Int      @default(1) @map("per_member_limit")
  allowStacking      Boolean  @default(false) @map("allow_stacking")
  status             String   @default("DRAFT") @db.VarChar(30)
  createdById        String?  @map("created_by_id") @db.VarChar(36)
  approvedById       String?  @map("approved_by_id") @db.VarChar(36)
  rejectionReason    String?  @map("rejection_reason") @db.Text
  analytics          Json? // { totalDiscountGiven, totalRevenueGenerated, timesClaimed }
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  coupons           Coupon[]
  couponRedemptions CouponRedemption[]
  referrals         Referral[]

  @@index([status, startDate, endDate, priority])
  @@map("campaigns")
}

model Coupon {
  id                      String   @id @map("_id") @db.VarChar(36)
  couponCode              String   @unique @map("coupon_code") @db.VarChar(50)
  name                    String   @db.VarChar(150)
  description             String?  @db.Text
  discountType            String   @default("PERCENTAGE") @map("discount_type") @db.VarChar(30)
  discountValue           Float    @map("discount_value")
  applicablePlans         Json?    @map("applicable_plans") // string[]
  startDate               DateTime @default(now()) @map("start_date")
  expiryDate              DateTime @map("expiry_date")
  usageLimit              Int      @default(0) @map("usage_limit")
  usedCount               Int      @default(0) @map("used_count")
  perMemberLimit          Int      @default(1) @map("per_member_limit")
  minimumMembershipAmount Float    @default(0) @map("minimum_membership_amount")
  newMemberOnly           Boolean  @default(false) @map("new_member_only")
  existingMemberOnly      Boolean  @default(false) @map("existing_member_only")
  gender                  String   @default("Any") @db.VarChar(20)
  minAge                  Int?     @map("min_age")
  maxAge                  Int?     @map("max_age")
  maritalStatus           Json?    @map("marital_status")
  verificationStatus      Json?    @map("verification_status")
  location                Json?
  qualification           Json?
  campaignId              String?  @map("campaign_id") @db.VarChar(36)
  isReferralReward        Boolean  @default(false) @map("is_referral_reward")
  issuedToUserId          String?  @map("issued_to_user_id") @db.VarChar(36)
  issuedToCandidateId     String?  @map("issued_to_candidate_id") @db.VarChar(50)
  allowStacking           Boolean  @default(false) @map("allow_stacking")
  status                  String   @default("ACTIVE") @db.VarChar(30)
  createdById             String?  @map("created_by_id") @db.VarChar(36)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  campaign      Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  redemptions   CouponRedemption[]
  referrals     Referral[]
  rewardRecords ReferralRewardRecord[]

  @@index([status, expiryDate])
  @@index([isReferralReward])
  @@index([issuedToUserId])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @map("_id") @db.VarChar(36)
  couponId       String   @map("coupon_id") @db.VarChar(36)
  couponCode     String   @map("coupon_code") @db.VarChar(50)
  userId         String   @map("user_id") @db.VarChar(36)
  candidateId    String?  @map("candidate_id") @db.VarChar(50)
  campaignId     String?  @map("campaign_id") @db.VarChar(36)
  planKey        String   @map("plan_key") @db.VarChar(100)
  originalAmount Float    @map("original_amount")
  discountAmount Float    @map("discount_amount")
  finalAmount    Float    @map("final_amount")
  paymentId      String?  @map("payment_id") @db.VarChar(150)
  orderId        String?  @map("order_id") @db.VarChar(150)
  redeemedAt     DateTime @default(now()) @map("redeemed_at")
  status         String   @default("SUCCESS") @db.VarChar(30)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([couponId, userId])
  @@index([redeemedAt])
  @@map("coupon_redemptions")
}

model Referral {
  id                  String    @id @map("_id") @db.VarChar(36)
  referrerUserId      String    @map("referrer_user_id") @db.VarChar(36)
  referrerCandidateId String    @map("referrer_candidate_id") @db.VarChar(50)
  referralCode        String    @map("referral_code") @db.VarChar(50)
  referredUserId      String?   @unique @map("referred_user_id") @db.VarChar(36)
  referredCandidateId String?   @map("referred_candidate_id") @db.VarChar(50)
  source              String?   @default("direct_link") @db.VarChar(100)
  ipAddress           String?   @map("ip_address") @db.VarChar(50)
  userAgent           String?   @map("user_agent") @db.VarChar(500)
  clickedAt           DateTime? @default(now()) @map("clicked_at")
  registeredAt        DateTime? @map("registered_at")
  qualifiedAt         DateTime? @map("qualified_at")
  status              String    @default("CLICKED") @db.VarChar(30) // 'CLICKED' | 'REGISTERED' | 'QUALIFIED' | 'REWARDED' | 'REJECTED' | 'EXPIRED'
  qualificationReason String?   @map("qualification_reason") @db.VarChar(255)
  rewardStatus        String    @default("PENDING") @map("reward_status") @db.VarChar(30)
  rewardRecordId      String?   @map("reward_record_id") @db.VarChar(36)
  couponId            String?   @map("coupon_id") @db.VarChar(36)
  campaignId          String?   @map("campaign_id") @db.VarChar(36)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

